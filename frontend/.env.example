# Base URL for frontend -> backend calls.
# Use `auto` to target the same host currently serving Mission Control on port 8000.
# Example explicit override: https://mc.example.com
NEXT_PUBLIC_API_URL=auto

# Auth mode: clerk or local.
# - clerk: Clerk sign-in flow
# - local: shared bearer token entered in UI
NEXT_PUBLIC_AUTH_MODE=local

# Clerk auth (used when NEXT_PUBLIC_AUTH_MODE=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/boards
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# OpenClaw Gateway token for local WS chat
NEXT_PUBLIC_OPENCLAW_GATEWAY_TOKEN=

# Full WebSocket URL of the OpenClaw gateway (e.g. ws://43.205.235.7:18789)
# If not set, defaults to ws://<current-hostname>:18789
NEXT_PUBLIC_OPENCLAW_GATEWAY_WS_URL=

NEXT_PUBLIC_CHAT_BOARD_ID=

# Plugin-chat mode — routes messages through the MC backend + openclaw channel plugin.
# Set NEXT_PUBLIC_MC_CHAT_BOARD_ID to a valid board ID to enable the "Plugin" mode toggle.
NEXT_PUBLIC_MC_CHAT_BOARD_ID=
# Optional: override which agent ID receives messages in plugin mode (default: main)
NEXT_PUBLIC_MC_CHAT_AGENT_ID=main
